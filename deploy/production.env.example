# Production deployments use a commit-addressed GHCR image.
# Replace FULL_COMMIT_SHA with the exact deployed Git commit.
#
# The automated deployment layer may further pin this to the registry
# sha256 digest after publication.
COMIC_DIARY_IMAGE=ghcr.io/flawden/comic-diary:FULL_COMMIT_SHA

# Host exposure remains loopback-only until reverse proxy is installed.
COMIC_DIARY_HOST_PORT=18082

POSTGRES_DB=comic_diary
POSTGRES_USER=comic_diary

# Use a long URL-safe random value in the real server env.
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_URL_SAFE_VALUE

# Technical VK import admin is disabled in production by default.
ADMIN_IMPORT_ENABLED=false

# Canonical HTTPS origin used by server-side CSRF/Origin checks.
# Must match the real public hostname; do not include a path or trailing slash.
COMIC_DIARY_PUBLIC_ORIGIN=https://comic-diary.2-26-67-21.sslip.io


# AUTH configuration contract: EXAMPLE ONLY, never place real secrets in Git.
# One shared existing Resend credential; no *_FILE loader exists in the app.
# Provision outside Git during a separately approved rollout. All sending stays OFF.
RESEND_API_KEY=

# Password recovery: independent runtime/request flags and durable PostgreSQL gate.
PASSWORD_RESET_REQUEST_ENABLED=false
PASSWORD_RESET_REQUEST_MAIL_READY=false
PASSWORD_RESET_REDEEM_ENABLED=false
AUTH_RECOVERY_WORKER_ENABLED=false
AUTH_RECOVERY_DISPATCH_ENABLED=false
AUTH_RECOVERY_SENDER_VERIFIED=false
AUTH_RECOVERY_RESEND_CONFIG_READY=false
AUTH_RECOVERY_FROM_ADDRESS=
AUTH_RECOVERY_SENDER_DOMAIN=
AUTH_RECOVERY_PUBLIC_ORIGIN=
PASSWORD_RESET_OUTBOX_KEY_ID=
PASSWORD_RESET_OUTBOX_KEY_BASE64=

# Registration and email activation: independent of recovery. Defaults are strict OFF.
REGISTRATION_ENABLED=false
REGISTRATION_ACTIVATION_REDEEM_ENABLED=false
AUTH_ACTIVATION_RESEND_CONFIG_READY=false
AUTH_ACTIVATION_SENDER_VERIFIED=false
AUTH_ACTIVATION_DISPATCH_ENABLED=false
AUTH_ACTIVATION_WORKER_ENABLED=false
AUTH_ACTIVATION_OPERATOR_CONTROL_ENABLED=false
AUTH_ACTIVATION_FROM_ADDRESS=
AUTH_ACTIVATION_SENDER_DOMAIN=
AUTH_ACTIVATION_PUBLIC_ORIGIN=
AUTH_ACTIVATION_OUTBOX_KEY_ID=
AUTH_ACTIVATION_OUTBOX_KEY_BASE64=

# Own-account legacy verification: explicit opt-in, shared activation worker.
AUTH_LEGACY_EMAIL_VERIFICATION_ENABLED=false
AUTH_LEGACY_EMAIL_VERIFICATION_REQUEST_ENABLED=false
