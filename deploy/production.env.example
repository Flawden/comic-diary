# Production deployments use a commit-addressed GHCR image.
# Replace FULL_COMMIT_SHA with the exact deployed Git commit.
#
# The automated deployment layer may further pin this to the registry
# sha256 digest after publication.
COMIC_DIARY_IMAGE=ghcr.io/flawden/comic-diary:FULL_COMMIT_SHA

# Host exposure remains loopback-only until reverse proxy is installed.
COMIC_DIARY_HOST_PORT=18082

POSTGRES_DB=comic_diary
POSTGRES_USER=comic_diary

# Use a long URL-safe random value in the real server env.
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_URL_SAFE_VALUE

# Technical VK import admin is disabled in production by default.
ADMIN_IMPORT_ENABLED=false
ADMIN_IMPORT_SECRET=