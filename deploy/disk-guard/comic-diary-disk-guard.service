# Managed by comic-diary-disk-guard-v1
[Unit]
Description=Comic Diary BR01 disk guard
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/comic-diary/disk-guard/guard.py --run
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/comic-diary-disk-guard
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
